---
// Greifbar-Logo: Knickarm, der den blauen Punkt greift (Variante A)
interface Props { size?: number; class?: string }
const { size = 64, class: cls = '' } = Astro.props;
---
<svg class={`logo ${cls}`} width={size} height={size} viewBox="0 0 100 100" aria-hidden="true">
  <path d="M14 90H46L42 82H18Z" fill="currentColor" />
  <path d="M30 76L44 38L75 45" fill="none" stroke="currentColor" stroke-width="9" stroke-linejoin="round" />
  <circle cx="30" cy="76" r="7" fill="var(--bg)" stroke="currentColor" stroke-width="4" />
  <circle cx="44" cy="38" r="7" fill="var(--bg)" stroke="currentColor" stroke-width="4" />
  <rect x="66" y="45" width="18" height="8" rx="2" fill="currentColor" />
  <path d="M68.5 53V69M81.5 53V69" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
  <circle cx="75" cy="64" r="6" fill="var(--dot)" />
</svg>
