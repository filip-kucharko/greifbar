---
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/500.css';
import '@fontsource/newsreader/600.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/playfair-display/900.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';
import '@fontsource/source-sans-3/700.css';
import '../styles/global.css';
import { RUBRIKEN } from '../rubriken';
import Logo from '../components/Logo.astro';
import { SEITE } from '../config';

interface Props {
  titel?: string;
  beschreibung?: string;
  aktiv?: string;
  bild?: string;
  bildAlt?: string;
  typ?: 'website' | 'article';
  datum?: Date;
}
const { titel, beschreibung = SEITE.beschreibung, aktiv = '', bild, bildAlt, typ = 'website', datum } = Astro.props;
const seitentitel = titel ? `${titel} – Greifbar` : 'Greifbar – Robotik aus dem DACH-Raum';
const basis = Astro.site ?? new URL('https://greifbar.eu');
const kanonisch = new URL(Astro.url.pathname, basis).href;
// SVG-Bilder zeigen LinkedIn & Co. nicht an, dann das Standardbild nehmen
const vorschaubild = new URL(bild && !bild.endsWith('.svg') ? bild : '/og-standard.png', basis).href;
const zaehlen = import.meta.env.PROD && SEITE.goatcounter;
---
<!doctype html>
<html lang="de-AT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitentitel}</title>
    <meta name="description" content={beschreibung} />
    <!-- Favicon: Google braucht ein quadratisches Icon, am besten ein Vielfaches von 48 px -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={kanonisch} />
    <link rel="alternate" type="application/rss+xml" title="Greifbar – alle Artikel" href={new URL('/rss.xml', basis).href} />
    <link rel="sitemap" href="/sitemap.xml" />
    <!-- Vorschau beim Teilen (LinkedIn, WhatsApp, X …) -->
    <meta property="og:site_name" content="Greifbar" />
    <meta property="og:locale" content="de_AT" />
    <meta property="og:type" content={typ} />
    <meta property="og:title" content={titel || seitentitel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={kanonisch} />
    <meta property="og:image" content={vorschaubild} />
    {bildAlt && <meta property="og:image:alt" content={bildAlt} />}
    {typ === 'article' && datum && <meta property="article:published_time" content={datum.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titel || seitentitel} />
    <meta name="twitter:description" content={beschreibung} />
    <meta name="twitter:image" content={vorschaubild} />
    {zaehlen && <script is:inline async data-goatcounter={`https://${SEITE.goatcounter}.goatcounter.com/count`} src="https://gc.zgo.at/count.js"></script>}
  </head>
  <body>
    <header class="kopf wrap">
      <div class="zeile">
        <span id="heute">Robotik-Nachrichten</span>
        <span>Deutschland · Österreich · Schweiz</span>
      </div>
      <a class="titelkopf" href="/" aria-label="Greifbar – Startseite"><Logo class="kopflogo" /><span class="wort">Greifbar<span>.</span></span></a>
      <p class="unterzeile">Robotik aus dem DACH-Raum – kurz, verständlich, eingeordnet</p>
      <nav class="nav" aria-label="Rubriken">
        <a href="/" aria-current={aktiv === 'start' ? 'page' : undefined}>Aktuell</a>
        {RUBRIKEN.map((r) => (
          <a href={`/rubrik/${r.slug}/`} aria-current={aktiv === r.slug ? 'page' : undefined}>{r.name}</a>
        ))}
        <a href="/archiv/" aria-current={aktiv === 'archiv' ? 'page' : undefined}>Archiv</a>
      </nav>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="fuss">
      <div class="wrap innen">
        <span class="marke"><Logo size={34} /><span>Greifbar<span>.</span></span></span>
        <nav aria-label="Service">
          <a href="/archiv/">Archiv</a>
          <a href="/ueber/">Über Greifbar</a>
          <a href="/impressum/">Impressum</a>
          <a href="/datenschutz/">Datenschutz</a>
        </nav>
        <span>© {new Date().getFullYear()} Greifbar</span>
      </div>
    </footer>

    <script is:inline>
      {
        const el = document.getElementById('heute');
        try {
          const t = new Date().toLocaleDateString('de-AT', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
          if (el) el.textContent = t;
        } catch (e) {}
      }
    </script>
  </body>
</html>
